# Copie para .env.local e preencha quando o projeto Supabase existir.
# Nenhuma tela usa isto ainda — é só a preparação para a integração futura.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Provedor de emissão fiscal (NF-e/NFC-e). Ponto único de troca — ver
# src/lib/fiscal/provider.ts. Valores: "simulado" (padrão, não emite nada de
# verdade e não faz chamada de rede) ou "focus-nfe" (ainda não implementado).
# Vazio ou desconhecido cai em "simulado": falha fechado, para nunca emitir
# nota real por engano.
VITE_FISCAL_PROVIDER=simulado
