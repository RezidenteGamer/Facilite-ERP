{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /*
     * Núcleo fiscal compartilhado com a Edge Function (Deno), em
     * supabase/functions/_shared/fiscal. Mesmo alias declarado em
     * vite.config.ts (build), vitest.config.ts (teste) e tsconfig.tests.json —
     * os quatro precisam concordar. Os arquivos do núcleo entram na compilação
     * por serem importados, então `tsc -b` também os checa.
     */
    "paths": {
      "@fiscal-core/*": ["./supabase/functions/_shared/fiscal/*"]
    }
  },
  "include": ["src"]
}
